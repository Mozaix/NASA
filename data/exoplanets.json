 "class_facts": {
  "terrestrial": [
   {
    "text": "Terrestrial planets (Earth sized and smaller) are rocky worlds, composed of rock, silicate, water and/or carbon.",
    "url": "https://science.nasa.gov/exoplanets/terrestrial/"
   },
   {
    "text": "To determine if some of these worlds have atmospheres, oceans or other signs of habitability, it takes more investigation.",
    "url": "https://science.nasa.gov/exoplanets/terrestrial/"
   },
   {
    "text": "We've found rocky planets in Earth's size range, at the right distance from their parent stars to harbor liquid water (this is known as the habitable zone).",
    "url": "https://science.nasa.gov/exoplanets/terrestrial/"
   }
  ],
  "super_earth": [
   {
    "text": "Larger terrestrial exoplanets (those at least twice as massive as Earth) are classified as super-Earths .",
    "url": "https://science.nasa.gov/exoplanets/terrestrial/"
   },
   {
    "text": "Super-Earths can be up to 10 times more massive than Earth.",
    "url": "https://science.nasa.gov/exoplanets/super-earth/"
   }
  ],
  "neptune_like": [
   {
    "text": "Neptunian planets typically have hydrogen and helium-dominated atmospheres with cores of rock and heavier metals.",
    "url": "https://science.nasa.gov/exoplanets/neptune-like/"
   },
   {
    "text": "By analyzing the amount of light blocked by the planet at different wavelengths, called spectroscopy, researchers can determine which molecules make up the atmosphere.",
    "url": "https://science.nasa.gov/exoplanets/neptune-like/"
   }
  ],
  "gas_giant": [
   {
    "text": "Similar in size to Jupiter, these gas-dominated planets orbit extremely close to their parent stars, circling them in as few as 18 hours.",
    "url": "https://science.nasa.gov/exoplanets/gas-giant/"
   },
   {
    "text": "Gas giants are planets the size of Saturn or Jupiter, the largest planet in our solar system, or much, much larger.",
    "url": "https://science.nasa.gov/exoplanets/planet-types/"
   },
   {
    "text": "They likely have a mixture of interior compositions, but all will have hydrogen and helium-dominated outer atmospheres and rocky cores.",
    "url": "https://science.nasa.gov/exoplanets/planet-types/"
   }
  ],
  "general": [
   {
    "text": "Most have been discovered by the \"transit\" method – watching for the tiniest of shadows as a planet crosses the face of its star.",
    "url": "https://science.nasa.gov/exoplanets/planet-types/"
   },
   {
    "text": "Our nearest neighboring star, Proxima Centauri, was found to possess at least one planet – probably a rocky one.",
    "url": "https://science.nasa.gov/exoplanets/planet-types/"
   }
  ]
 },
